{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DigitalNewsMediaObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::digitalnews-media-prod/*"
    },
    {
      "Sid": "DigitalNewsMediaBucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::digitalnews-media-prod"
    }
  ]
}
