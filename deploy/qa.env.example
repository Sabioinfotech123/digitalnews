# AK News QA environment template
# Copy on the EC2 host only:
#   cp deploy/qa.env.example deploy/.env.qa
# deploy/.env.qa is gitignored (matches .env.*) — never commit real values.

# --- PostgreSQL (aknews-db, internal 5432, not published) ---
POSTGRES_USER=aknews
POSTGRES_PASSWORD=change-me-qa-db-password
POSTGRES_DB=aknews

# Must use Docker DNS host aknews-db and internal port 5432.
# If the password contains @ : / # ?, URL-encode it.
DATABASE_URL=postgresql+psycopg2://aknews:change-me-qa-db-password@aknews-db:5432/aknews

# --- Auth ---
JWT_SECRET_KEY=change-me-qa-jwt-secret-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public QA origin(s) the existing reverse proxy will serve, comma-separated.
# Same-origin /api/v1 via nginx does not need CORS for browser XHR, but set this
# to the real hostname. Do not use *. Credentials are enabled on the API.
CORS_ORIGINS=https://YOUR_QA_HOSTNAME

DEBUG=false

# Created on first API boot only if this email does not already exist.
ADMIN_EMAIL=qa-admin@example.com
ADMIN_PASSWORD=change-me-qa-admin-password
ADMIN_FULL_NAME=QA Admin

# --- Uploads ---
STORAGE_BACKEND=s3
MAX_IMAGE_SIZE_MB=5
# Lower than local default: the API currently buffers the whole file in memory.
MAX_VIDEO_SIZE_MB=20

# --- AWS S3 (QA) ---
# Fill on the server. Never commit real keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=digitalnews-media
AWS_S3_PUBLIC_BASE_URL=https://digitalnews-media.s3.us-east-1.amazonaws.com
