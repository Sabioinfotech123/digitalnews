DATABASE_URL=postgresql+psycopg2://digitalnews:digitalnews@localhost:5433/digitalnews
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# true = any localhost / 127.0.0.1 port may call this API (local Vite against QA). Set false in production.
CORS_ALLOW_LOCALHOST=true
# Restart uvicorn / container after changing these.

STORAGE_BACKEND=s3
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=100

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=digitalnews-media-prod
AWS_S3_PUBLIC_BASE_URL=https://digitalnews-media-prod.s3.us-east-1.amazonaws.com
READ_ALOUD_POLLY_ENABLED=true

DEBUG=true
# ADMIN_* — creates admin on first API boot; if DEBUG=true, password/name sync from .env on each restart.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_FULL_NAME=Site Admin

# Local news: Google News RSS by default (fast, no key).
# Optional — set for NewsAPI.org instead (richer images/text; free key from newsapi.org):
# NEWS_API_KEY=
# LOCAL_NEWS_PLACEHOLDER_IMAGE=https://placehold.co/1200x675/111111/ffffff/png?text=Local+News

# OpenRouter — Agent, CMS AI (Enhance/Regenerate), Local feed verify. One key, model failover list.
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODELS=google/gemini-2.0-flash-exp:free,openai/gpt-4o-mini
# AGENT_REFETCH_MINUTES=15
# AGENT_LLM_TIMEOUT_SEC=120
