DATABASE_URL=postgresql+psycopg2://digitalnews:digitalnews@localhost:5433/digitalnews
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
# On a remote server, keep localhost entries so local Vite (npm run dev) can call the API.
# Restart uvicorn / container after changing this.

STORAGE_BACKEND=s3
MAX_IMAGE_SIZE_MB=5
MAX_VIDEO_SIZE_MB=100

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=digitalnews-media-prod
AWS_S3_PUBLIC_BASE_URL=https://digitalnews-media-prod.s3.us-east-1.amazonaws.com

DEBUG=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345
ADMIN_FULL_NAME=Site Admin

# Local news: Google News RSS by default (fast, no key).
# Optional — set for NewsAPI.org instead (richer images/text; free key from newsapi.org):
# NEWS_API_KEY=
# LOCAL_NEWS_PLACEHOLDER_IMAGE=https://placehold.co/1200x675/111111/ffffff/png?text=Local+News

# AI verify (Local feed → Verified news). Provider: gemini | openai
# gemini = try Gemini first; if flaky (503/high demand/etc.) and OPENAI_API_KEY is set, fall back to OpenAI
# openai = OpenAI only
AI_VERIFY_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
